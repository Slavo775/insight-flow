{
  "name": "insight-flow",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --dir packages/taskflow run build",
    "build:package": "pnpm --dir packages/taskflow run build",
    "pack:taskflow": "pnpm --dir packages/taskflow exec npm pack",
    "play": "pnpm --dir playground run ui",
    "ui": "node packages/taskflow/dist/cli.js ui",
    "master": "node packages/taskflow/dist/cli.js master",
    "master:dev": "pnpm --dir packages/taskflow run build && node packages/taskflow/dist/cli.js master"
  }
}
