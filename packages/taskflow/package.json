{
  "name": "taskflow",
  "version": "0.2.0",
  "description": "Storybook for tasking — AI-assisted task lifecycle management with a bundled React dashboard",
  "type": "module",
  "bin": {
    "taskflow": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:cli": "tsup",
    "build:ui": "node ../../scripts/build-taskflow-ui.mjs",
    "build": "pnpm run build:cli && pnpm run build:ui",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Slavo Sedlak <slavomir.sedlak.webdev@gmail.com>",
  "homepage": "https://github.com/Slavo775/insight-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slavo775/insight-flow.git",
    "directory": "packages/taskflow"
  },
  "bugs": {
    "url": "https://github.com/Slavo775/insight-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "taskflow",
    "task-management",
    "claude-code",
    "ai-tasks",
    "storybook-for-tasks",
    "dashboard",
    "cli"
  ]
}
