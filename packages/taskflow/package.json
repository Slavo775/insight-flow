{
  "name": "taskflow",
  "version": "0.1.0",
  "description": "Storybook for tasking — AI-assisted task lifecycle management with built-in dashboard",
  "type": "module",
  "bin": {
    "taskflow": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "schema",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "taskflow",
    "task-management",
    "claude-code",
    "ai-tasks",
    "storybook-for-tasks",
    "cli"
  ]
}
