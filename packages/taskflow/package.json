{
  "name": "insight-flow",
  "version": "1.0.0",
  "description": "A workbench for AI-assisted task lifecycle management — CLI plus a self-contained server-rendered dashboard",
  "type": "module",
  "bin": {
    "insight-flow": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "schema",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && rm -rf dist/sounds && cp -r src/dashboard/server/sounds dist/sounds",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.mjs\"",
    "test": "pnpm run build && pnpm run test:node",
    "test:node": "node --test --test-concurrency=1 test/*.test.mjs",
    "sync-roles": "node scripts/sync-role-templates.mjs",
    "prepublishOnly": "npm run sync-roles && npm run build && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Slavo Sedlak <slavomir.sedlak.webdev@gmail.com>",
  "homepage": "https://github.com/Slavo775/insight-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slavo775/insight-flow.git",
    "directory": "packages/taskflow"
  },
  "bugs": {
    "url": "https://github.com/Slavo775/insight-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "taskflow",
    "task-management",
    "claude-code",
    "ai-tasks",
    "task-workbench",
    "dashboard",
    "cli"
  ],
  "dependencies": {
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  }
}
