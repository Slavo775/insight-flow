{
  "name": "insight-flow",
  "version": "2.10.0",
  "description": "A workbench for AI-assisted task lifecycle management — CLI plus a self-contained server-rendered dashboard",
  "type": "module",
  "bin": {
    "insight-flow": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "schema",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && vite build && vite build --config vite.master.config.ts && vite build --config vite.hub-notify.config.ts && rm -rf dist/sounds && cp -r src/dashboard/server/sounds dist/sounds",
    "dev": "tsup --watch",
    "dev:dashboard": "vite",
    "dev:master": "vite --config vite.master.config.ts",
    "typecheck": "tsc --noEmit && tsc -p src/dashboard/client/tsconfig.json --noEmit && tsc -p src/master/client/tsconfig.json --noEmit",
    "typecheck:client": "tsc -p src/dashboard/client/tsconfig.json --noEmit && tsc -p src/master/client/tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\" \"test/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.tsx\" \"test/**/*.mjs\"",
    "test": "pnpm run build && pnpm run test:node",
    "test:node": "node --test --test-concurrency=1 test/*.test.mjs",
    "sync-roles": "node scripts/sync-role-templates.mjs",
    "prepublishOnly": "npm run sync-roles && npm run build && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Slavo Sedlak <slavomir.sedlak.webdev@gmail.com>",
  "homepage": "https://github.com/Slavo775/insight-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slavo775/insight-flow.git",
    "directory": "packages/taskflow"
  },
  "bugs": {
    "url": "https://github.com/Slavo775/insight-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "taskflow",
    "task-management",
    "claude-code",
    "ai-tasks",
    "task-workbench",
    "dashboard",
    "cli"
  ],
  "peerDependencies": {
    "langfuse": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "langfuse": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xyflow/react": "^12.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.4",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.4.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
