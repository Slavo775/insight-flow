{
  "name": "insight-flow",
  "version": "0.4.0",
  "description": "A workbench for AI-assisted task lifecycle management — CLI plus a self-contained server-rendered dashboard",
  "type": "module",
  "bin": {
    "insight-flow": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "schema",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node test/init.test.mjs && node test/migrate-reviews.test.mjs && node test/scaffold-and-bundle.test.mjs && node test/no-technology-tight.test.mjs",
    "sync-roles": "node scripts/sync-role-templates.mjs",
    "prepublishOnly": "npm run sync-roles && npm run build && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Slavo Sedlak <slavomir.sedlak.webdev@gmail.com>",
  "homepage": "https://github.com/Slavo775/insight-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slavo775/insight-flow.git",
    "directory": "packages/taskflow"
  },
  "bugs": {
    "url": "https://github.com/Slavo775/insight-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "taskflow",
    "task-management",
    "claude-code",
    "ai-tasks",
    "task-workbench",
    "dashboard",
    "cli"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  }
}
