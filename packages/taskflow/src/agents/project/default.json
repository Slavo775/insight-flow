{
  "id": "default",
  "title": "insight-flow default project",
  "description": "The canonical task lifecycle: strategy → spec → implementation → review loop → human gate, with change-request and incident side-flows. Installs the activity telemetry hooks.",
  "agents": [
    "task-analyze",
    "taskmaster",
    "taskmaster-change",
    "task-implement",
    "task-review",
    "task-review-fix",
    "task-human-review",
    "task-request-changes",
    "task-incident",
    "task-git"
  ],
  "flow": [
    { "from": "task-analyze", "to": "taskmaster" },
    { "from": "taskmaster", "to": "task-implement", "on": "ready" },
    { "from": "taskmaster-change", "to": "task-implement", "on": "ready" },
    { "from": "task-implement", "to": "task-git", "on": "implemented" },
    { "from": "task-git", "to": "task-review", "on": "pushed" },
    { "from": "task-review", "to": "task-human-review", "on": "approved" },
    { "from": "task-review", "to": "task-review-fix", "on": "fix-needed" },
    { "from": "task-review-fix", "to": "task-review", "on": "fixed" },
    { "from": "task-human-review", "to": "task-review-fix", "on": "fix-needed" },
    { "from": "task-human-review", "to": "task-git", "on": "approved" },
    { "from": "task-human-review", "to": "task-request-changes", "on": "done" },
    { "from": "task-request-changes", "to": "task-implement", "on": "changes-requested" },
    { "from": "task-implement", "to": "task-git", "on": "changes-implemented" }
  ],
  "install": ["activity"],
  "statuses": [
    { "id": "ready", "title": "ready", "color": "#94a3b8" },
    { "id": "in-progress", "title": "in-progress", "color": "#f59e0b" },
    { "id": "implemented", "title": "implemented", "color": "#06b6d4" },
    { "id": "reviewing", "title": "reviewing", "color": "#a855f7" },
    { "id": "approved", "title": "approved", "color": "#22c55e" },
    { "id": "fix-needed", "title": "fix-needed", "color": "#ef4444" },
    { "id": "fixing", "title": "fixing", "color": "#dc2626" },
    { "id": "fixed", "title": "fixed", "color": "#22c55e" },
    { "id": "pushed", "title": "pushed", "color": "#16a34a" },
    { "id": "merged", "title": "merged", "color": "#10b981", "terminal": true },
    { "id": "done", "title": "done", "terminal": true },
    { "id": "request-changes", "title": "request-changes" },
    { "id": "changes-requested", "title": "changes-requested", "color": "#f97316" },
    { "id": "changes-implementing", "title": "changes-implementing", "color": "#fb923c" },
    { "id": "changes-implemented", "title": "changes-implemented", "color": "#14b8a6" }
  ],
  "entryAgents": ["task-analyze", "taskmaster"]
}
